# Build requests from the pad maker are emailed to The Pad King.
# Email is sent through Resend's HTTP API (https://resend.com) - no SDK needed.
RESEND_API_KEY=
# Where build requests land (Matt's inbox)
BUILD_REQUEST_TO=
# Verified sender on the Resend account, e.g. "The Pad King <builds@thepadking.com.au>"
BUILD_REQUEST_FROM=
