# Build requests from the pad maker are emailed to The Pad King.
# Email is sent through Resend's HTTP API (https://resend.com) - no SDK needed.
RESEND_API_KEY=
# Where build requests land (Matt's inbox)
BUILD_REQUEST_TO=
# Verified sender on the Resend account, e.g. "The Pad King <builds@thepadking.com.au>"
BUILD_REQUEST_FROM=

# Public address of the app, e.g. https://app.thepadking.com.au
# Used for share previews (the image and link shown when the app is shared).
# Not needed on Vercel.
NEXT_PUBLIC_SITE_URL=

# Analytics: set ONE of these, or neither (nothing is tracked).
# Plausible (recommended, no cookies): the script URL from Site settings > Site installation,
# e.g. https://plausible.io/js/pa-XXXXXXXX.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
